# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
# Public storefront address: base of the customer order links sent by WhatsApp
PUBLIC_SITE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://kaizen:kaizen@localhost:5440/kaizen?schema=public

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Admin session: closes after SESSION_IDLE_MINUTES without activity, once the
# "extend session?" prompt (SESSION_PROMPT_SECONDS countdown) runs out.
# The cookie/token lifetime is derived from both (idle + prompt + a small margin).
SESSION_IDLE_MINUTES=30
SESSION_PROMPT_SECONDS=30

# Seed admin (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@kaizen.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Administrador

# Cloudinary (leave empty to store images on local disk under ./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orders (Phase 3)
# Hours an unpaid order waits for its Pago Móvil proof before it expires (stock is restored).
ORDER_PAYMENT_WINDOW_HOURS=24
# How often overdue unpaid orders are expired.
ORDER_EXPIRY_INTERVAL_MINUTES=10

# BCV exchange rate (bcv.org.ve first, ve.dolarapi.com as fallback)
# Checkout refuses orders when the newest rate's "fecha valor" is older than this.
EXCHANGE_RATE_MAX_AGE_HOURS=72
# How often the rate is fetched (also fetched once at startup).
EXCHANGE_RATE_SYNC_INTERVAL_MINUTES=120
# Background jobs (rate sync, order expiry). Leave empty: on, except under NODE_ENV=test.
SCHEDULED_JOBS_ENABLED=

# Telegram bot (optional; without a token the bot is off)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_ENABLED=true
# TELEGRAM_MODE=polling            # production default: webhook
# TELEGRAM_WEBHOOK_SECRET=         # required in webhook mode (openssl rand -hex 32)

MAIL_DRIVER=smtp
MAIL_FROM="KaiZen Perfumería <pedidos@kaizen.test>"
MAIL_REPLY_TO=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
SMTP_PORT=1026


